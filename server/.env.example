# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# Frontend URL
FRONTEND_URL=http://localhost:5173

# JWT Secrets
JWT_SECRET_ADMIN=your_admin_jwt_secret_here
JWT_SECRET_ALUMNI=your_alumni_jwt_secret_here

# Environment
NODE_ENV=development

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM_NAME=Back2Campus Demo

# Application Secret
my_secret_key=your_application_secret_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret